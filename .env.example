# Copie para .env e ajuste os valores antes de subir em producao.
DB_NAME=siscep
DB_USERNAME=siscep
DB_PASSWORD=troque-esta-senha
# Chave HMAC do JWT: minimo 32 caracteres aleatorios (ex.: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRACAO_MINUTOS=480
WEB_PORT=80
API_PORT=8080
BACKUP_HORARIO=02:00
# Opcional: espelho do Maven Central usado no build da imagem da API
MAVEN_MIRROR_URL=
